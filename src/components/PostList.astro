---
import { formatDate, type BlogPost } from "../lib/blog";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<ul class="blog-list">
  {
    posts.map((post) => (
      <li class="blog-item">
        <time class="blog-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <a href={`/blog/${post.id}`}>{post.data.title}</a>
      </li>
    ))
  }
</ul>
