---
import Lang from "./Lang.astro";
import { formatDate, type BlogPost } from "../lib/blog";
import { titlesForPost } from "../lib/bilingual";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<ul class="blog-list">
  {
    posts.map((post) => {
      const titles = titlesForPost(post.data);
      return (
        <li class="blog-item">
          <time class="blog-date" datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          <a href={`/blog/${post.id}`}>
            <Lang en={titles.en || titles.zh} zh={titles.zh || titles.en} />
          </a>
        </li>
      );
    })
  }
</ul>
