---
import { site } from "../data/site";
import Lang from "./Lang.astro";
---

<div class="footer-hold">
  <footer class="site-footer">
    <div class="footer-cols">
      <nav aria-label="footer">
        <a href="/"><Lang en="About" zh="关于" /></a>
        <a href="/blog"><Lang en="Blog" zh="博客" /></a>
      </nav>
      <div>
        {
          site.emails.map((address) => (
            <a href={`mailto:${address}`}>{address}</a>
          ))
        }
      </div>
      <div>
        {
          site.social.github && (
            <a href={site.social.github} rel="noopener noreferrer">
              GitHub
            </a>
          )
        }
      </div>
      <p>
        <Lang en="my life goal is to achieve communism." zh="我的人生目标是实现共产主义。" />
      </p>
    </div>
    <p class="wordmark">{site.name}</p>
  </footer>
</div>
