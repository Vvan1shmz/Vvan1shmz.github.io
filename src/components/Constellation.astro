<canvas class="constellation" id="constellation" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("constellation") as HTMLCanvasElement | null;
  const lamp = document.getElementById("pointer-light");
  if (canvas) {
    const ctx = canvas.getContext("2d");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    if (ctx) {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const points: {
        ox: number;
        oy: number;
        x: number;
        y: number;
        vx: number;
        vy: number;
        r: number;
        hue: number;
      }[] = [];
      const mouse = { x: 0, y: 0, on: false };
      let raf = 0;

      function resize() {
        canvas.width = Math.floor(window.innerWidth * dpr);
        canvas.height = Math.floor(window.innerHeight * dpr);
        canvas.style.width = `${window.innerWidth}px`;
        canvas.style.height = `${window.innerHeight}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        seed();
        draw(0);
      }

      function seed() {
        points.length = 0;
        const count = Math.round((window.innerWidth * window.innerHeight) / 24000);
        for (let i = 0; i < Math.max(22, count); i++) {
          const x = Math.random() * window.innerWidth;
          const y = Math.random() * window.innerHeight;
          points.push({
            ox: x,
            oy: y,
            x,
            y,
            vx: 0,
            vy: 0,
            r: 1.15 + Math.random() * 1.7,
            hue: [0, 38, 195, 250][i % 4],
          });
        }
      }

      function nearCursor(px: number, py: number) {
        if (!mouse.on) return 0;
        const dist = Math.hypot(mouse.x - px, mouse.y - py);
        return dist < 280 ? 1 - dist / 280 : 0;
      }

      function isLight() {
        return document.documentElement.getAttribute("data-theme") === "light";
      }

      function draw(t: number) {
        const light = isLight();
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        ctx.lineWidth = 0.8;
        for (let i = 0; i < points.length; i++) {
          for (let j = i + 1; j < points.length; j++) {
            const dx = points[i].x - points[j].x;
            const dy = points[i].y - points[j].y;
            const dist = Math.hypot(dx, dy);
            if (dist < 170) {
              const heat = Math.max(nearCursor(points[i].x, points[i].y), nearCursor(points[j].x, points[j].y));
              const alpha = (0.12 + heat * 0.28) * (1 - dist / 170);
              ctx.strokeStyle = `hsla(${points[i].hue}, ${light ? 32 : 48}%, ${light ? 26 : 76}%, ${alpha})`;
              ctx.beginPath();
              ctx.moveTo(points[i].x, points[i].y);
              ctx.lineTo(points[j].x, points[j].y);
              ctx.stroke();
            }
          }
        }
        for (const p of points) {
          const pulse = reduceMotion ? 1 : 0.78 + Math.sin(t / 1100 + p.x) * 0.22;
          const heat = nearCursor(p.x, p.y);
          ctx.fillStyle = `hsla(${p.hue}, ${light ? 24 : 32}%, ${light ? 22 : 88}%, ${(0.42 + heat * 0.5) * pulse})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r + heat * 1.7, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      function step(now: number) {
        if (!reduceMotion) {
          for (const p of points) {
            let ax = (p.ox - p.x) * 0.018;
            let ay = (p.oy - p.y) * 0.018;
            if (mouse.on) {
              const dx = mouse.x - p.x;
              const dy = mouse.y - p.y;
              const dist = Math.hypot(dx, dy) || 1;
              if (dist < 260) {
                const pull = (1 - dist / 260) * 0.06;
                ax += dx * pull;
                ay += dy * pull;
              }
            }
            p.vx = (p.vx + ax) * 0.84;
            p.vy = (p.vy + ay) * 0.84;
            p.x += p.vx;
            p.y += p.vy;
          }
        }
        draw(now);
        raf = requestAnimationFrame(step);
      }

      function onMove(event: PointerEvent) {
        mouse.x = event.clientX;
        mouse.y = event.clientY;
        mouse.on = true;
        document.documentElement.style.setProperty("--pointer-x", `${event.clientX}px`);
        document.documentElement.style.setProperty("--pointer-y", `${event.clientY}px`);
        lamp?.classList.add("is-on");
      }

      function onLeave() {
        mouse.on = false;
        lamp?.classList.remove("is-on");
      }

      window.addEventListener("resize", resize);
      resize();

      if (!reduceMotion) {
        raf = requestAnimationFrame(step);
      }

      if (finePointer && !reduceMotion) {
        window.addEventListener("pointermove", onMove);
        document.documentElement.addEventListener("mouseleave", onLeave);
      }

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          cancelAnimationFrame(raf);
        } else if (!reduceMotion) {
          raf = requestAnimationFrame(step);
        }
      });

      new MutationObserver(() => draw(performance.now())).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
    }
  }
</script>
