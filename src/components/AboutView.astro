---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import ContactLine from "./ContactLine.astro";

interface Props {
  about: CollectionEntry<"pages">;
  lang: "en" | "zh";
}

const { about, lang } = Astro.props;
const { Content } = await render(about);

const copy =
  lang === "zh"
    ? {
        beliefs: "这些是我相信的：",
        likes: "这些是我喜欢的：",
        dislikes: "这些我不喜欢：",
      }
    : {
        beliefs: "here are some things i believe in:",
        likes: "here are some things i like:",
        dislikes: "things i don't like:",
      };
---

<div class="lang-block" data-lang-panel={lang}>
  <div class="prose">
    <h1 class="lede">{about.data.lede}</h1>
    <p class="lede-sub">{about.data.goal}</p>
    <Content />
  </div>

  <section class="section">
    <h2>{copy.beliefs}</h2>
    <ul class="beliefs">
      {about.data.beliefs.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="section">
    <h2>{copy.likes}</h2>
    <p class="likes">{about.data.likes}</p>
  </section>

  <section class="section">
    <h2>{copy.dislikes}</h2>
    <ul class="list">
      {about.data.dislikes.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="section prose">
    <ContactLine lang={lang} />
  </section>
</div>
