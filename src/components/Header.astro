---
import { site } from "../data/site";
import Lang from "./Lang.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="header">
  <div class="header-inner">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id="prism" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#c84b4b"></stop>
            <stop offset="45%" stop-color="#e4c36a"></stop>
            <stop offset="100%" stop-color="#6b7fd7"></stop>
          </linearGradient>
        </defs>
        <circle cx="16" cy="16" r="11" fill="none" stroke="url(#prism)" stroke-width="1.6"></circle>
        <circle cx="16" cy="16" r="2.2" fill="currentColor"></circle>
      </svg>
      {site.name}
    </a>
    <nav class="nav" aria-label="primary">
      <a href="/" aria-current={path === "/" ? "page" : undefined}>
        <Lang en="About" zh="关于" />
      </a>
      <a href="/blog" aria-current={path.startsWith("/blog") ? "page" : undefined}>
        <Lang en="Blog" zh="博客" />
      </a>
    </nav>
    <div class="social">
      {
        site.social.x && (
          <a href={site.social.x} target="_blank" rel="noopener noreferrer" aria-label="X">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.9 2H22l-6.8 7.8L23 22h-6.3l-4.9-6.4L6.2 22H3.1l7.3-8.3L1 2h6.5l4.4 5.8L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z"></path>
            </svg>
          </a>
        )
      }
      {
        site.social.github && (
          <a href={site.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.2-3.4-1.2-.4-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7 3.6 3.6 0 0 1 .1-2.6s.8-.3 2.7 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .4.8.4 1.8.1 2.6a3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.8v2.6c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"></path>
            </svg>
          </a>
        )
      }
      {
        site.social.linkedin && (
          <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4.98 3.5A2.5 2.5 0 1 1 2.5 6a2.5 2.5 0 0 1 2.48-2.5ZM3 8.5h4V21H3V8.5Zm7 0h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 6V21h-4v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V21h-4V8.5Z"></path>
            </svg>
          </a>
        )
      }
      <button type="button" class="pref pref-lang" id="lang-toggle" aria-label="switch to chinese">
        <span data-lang-panel="en">中</span>
        <span data-lang-panel="zh">EN</span>
      </button>
      <button
        type="button"
        class="pref pref-theme"
        id="theme-toggle"
        aria-label="switch to light theme"
        aria-pressed="false"
      >
        <span class="pref-swap" aria-hidden="true">
          <svg class="pref-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="3.6"></circle>
            <path
              stroke-linecap="round"
              d="M12 3.2v1.7M12 19.1v1.7M4.5 4.5l1.2 1.2M18.3 18.3l1.2 1.2M3.2 12h1.7M19.1 12h1.7M4.5 19.5l1.2-1.2M18.3 5.7l1.2-1.2"
            ></path>
          </svg>
          <svg class="pref-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path
              stroke-linejoin="round"
              d="M16.2 13.4A6.4 6.4 0 0 1 10.6 5.5 6.6 6.6 0 1 0 16.2 13.4Z"
            ></path>
          </svg>
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector(".header");
  if (header instanceof HTMLElement) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 10);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  const THEME_KEY = "vvan1shmz-theme";
  const LANG_KEY = "vvan1shmz-lang";
  const LIGHT_COLOR = "#f4efe6";
  const DARK_COLOR = "#070708";

  function currentTheme() {
    return document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
  }

  function currentLang() {
    return document.documentElement.getAttribute("data-lang") === "zh" ? "zh" : "en";
  }

  function syncButtons() {
    const themeBtn = document.getElementById("theme-toggle");
    const langBtn = document.getElementById("lang-toggle");
    const light = currentTheme() === "light";
    const zh = currentLang() === "zh";

    if (themeBtn instanceof HTMLButtonElement) {
      themeBtn.setAttribute("aria-pressed", light ? "true" : "false");
      themeBtn.setAttribute(
        "aria-label",
        zh
          ? light
            ? "切换到深色主题"
            : "切换到浅色主题"
          : light
            ? "switch to dark theme"
            : "switch to light theme",
      );
    }

    if (langBtn instanceof HTMLButtonElement) {
      langBtn.setAttribute("aria-label", zh ? "切换到英文" : "switch to chinese");
    }
  }

  function applyTheme(theme: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", theme);
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute("content", theme === "light" ? LIGHT_COLOR : DARK_COLOR);
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      /* private mode */
    }
    syncButtons();
  }

  function applyLang(lang: "en" | "zh") {
    document.documentElement.setAttribute("data-lang", lang);
    document.documentElement.lang = lang === "zh" ? "zh-Hans" : "en";
    try {
      localStorage.setItem(LANG_KEY, lang);
    } catch {
      /* private mode */
    }
    syncButtons();
  }

  const themeBtn = document.getElementById("theme-toggle");
  const langBtn = document.getElementById("lang-toggle");
  themeBtn?.addEventListener("click", () => {
    applyTheme(currentTheme() === "light" ? "dark" : "light");
  });
  langBtn?.addEventListener("click", () => {
    applyLang(currentLang() === "zh" ? "en" : "zh");
  });
  syncButtons();
</script>
