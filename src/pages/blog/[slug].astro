---
import Layout from "../../layouts/Layout.astro";
import Lang from "../../components/Lang.astro";
import { render } from "astro:content";
import { formatDate, getPublishedPosts } from "../../lib/blog";
import { getCategory } from "../../data/categories";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const category = getCategory(post.data.category);
---

<Layout title={`${post.data.title} · vvan1shmz`} description={post.data.description}>
  <a class="back" href="/blog"><Lang en="Blog" zh="博客" /></a>
  <article class="article">
    <h1 class="article-title">{post.data.title}</h1>
    <p class="article-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {
        category && (
          <>
            <span aria-hidden="true"> · </span>
            <a href={`/blog/category/${category.id}`}>
              <Lang en={category.label} zh={category.labelZh} />
            </a>
          </>
        )
      }
    </p>
    <Content />
  </article>
</Layout>
