---
import Layout from "../../layouts/Layout.astro";
import Lang from "../../components/Lang.astro";
import {
  descriptionsForPost,
  renderMarkdown,
  splitBilingualBody,
  titlesForPost,
  type PostLang,
} from "../../lib/bilingual";
import { formatDate, getPublishedPosts } from "../../lib/blog";
import { getCategory } from "../../data/categories";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const source = (post.data.lang ?? "en") as PostLang;
const titles = titlesForPost(post.data);
const descriptions = descriptionsForPost(post.data);
const bodies = splitBilingualBody(post.body ?? "", source);
const html = {
  en: bodies.en ? await renderMarkdown(bodies.en) : "",
  zh: bodies.zh ? await renderMarkdown(bodies.zh) : "",
};
const category = getCategory(post.data.category);

function panel(lang: PostLang) {
  const title = titles[lang] || titles[source];
  const bodyHtml = html[lang] || html[source];
  const hasOwn = Boolean(titles[lang] && html[lang]);
  const isTranslation = hasOwn && lang !== source;
  const missing = !html[lang] && Boolean(html[source]);
  return { title, bodyHtml, hasOwn, isTranslation, missing };
}

const en = panel("en");
const zh = panel("zh");
const metaDescription = descriptions.en || descriptions.zh || post.data.description;
---

<Layout title={`${titles.en || titles.zh} · vvan1shmz`} description={metaDescription}>
  <a class="back" href="/blog"><Lang en="Blog" zh="博客" /></a>
  <article class="article">
    <div class="lang-block" data-lang-panel="en">
      <h1 class="article-title">{en.title}</h1>
      <p class="article-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {
          category && (
            <>
              <span aria-hidden="true"> · </span>
              <a href={`/blog/category/${category.id}`}>{category.label}</a>
            </>
          )
        }
      </p>
      {
        en.isTranslation && (
          <p class="article-note">translated from chinese.</p>
        )
      }
      {
        en.missing && (
          <p class="article-note">english version not ready yet. showing the chinese text.</p>
        )
      }
      <div class="prose" set:html={en.bodyHtml} />
    </div>

    <div class="lang-block" data-lang-panel="zh">
      <h1 class="article-title">{zh.title}</h1>
      <p class="article-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {
          category && (
            <>
              <span aria-hidden="true"> · </span>
              <a href={`/blog/category/${category.id}`}>{category.labelZh}</a>
            </>
          )
        }
      </p>
      {
        zh.isTranslation && (
          <p class="article-note">由英文译出。</p>
        )
      }
      {
        zh.missing && (
          <p class="article-note">中文稿还没有。先看英文原文。</p>
        )
      }
      <div class="prose" set:html={zh.bodyHtml} />
    </div>
  </article>
</Layout>
