---
import Layout from "../../layouts/Layout.astro";
import CategoryNav from "../../components/CategoryNav.astro";
import PostList from "../../components/PostList.astro";
import { getPublishedPosts, groupedPosts, usedCategories } from "../../lib/blog";

const posts = await getPublishedPosts();
const groups = groupedPosts(posts);
const used = usedCategories(posts);
---

<Layout title="Blog · vvan1shmz" description="Posts from vvan1shmz.">
  {
    posts.length ? (
      <>
        <h1 class="page-kicker">blog</h1>
        <CategoryNav current="all" used={used} />
        {groups.map((group) => (
          <section class="blog-group" aria-labelledby={`cat-${group.id}`}>
            <h2 class="blog-group-title" id={`cat-${group.id}`}>
              <a href={`/blog/category/${group.id}`}>{group.label}</a>
            </h2>
            <PostList posts={group.posts} />
          </section>
        ))}
      </>
    ) : (
      <p class="empty">nothing here yet.</p>
    )
  }
</Layout>
