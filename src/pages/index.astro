---
import Layout from "../layouts/Layout.astro";
import AboutView from "../components/AboutView.astro";
import { getEntry } from "astro:content";

const about = await getEntry("pages", "about");
const aboutZh = await getEntry("pages", "about-zh");
if (!about || !aboutZh) {
  throw new Error("Missing src/content/pages/about.md or about-zh.md");
}
---

<Layout>
  <AboutView about={about} lang="en" />
  <AboutView about={aboutZh} lang="zh" />
</Layout>
