---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";

const mail = site.email ? `mailto:${site.email}` : site.social.github;
---

<Layout>
  <div class="prose">
    <p>hi! i'm {site.shortName}</p>
    <p>my life goal is to write things down until they become clear.</p>
    <p>
      this is my personal site. about is a short, honest introduction. <a href="/blog">blog</a> is for longer notes. the page is meant to stay quiet: more whitespace, less decoration, easier to read.
    </p>
  </div>

  <section class="section">
    <h2>here are some things i believe in:</h2>
    <ul class="beliefs">
      <li>agency is a superpower</li>
      <li>taste is learnable</li>
      <li>write things down</li>
      <li>most problems can be taken apart</li>
      <li>everything is figureoutable with friends</li>
      <li>tools should stay out of the way</li>
    </ul>
  </section>

  <section class="section">
    <h2>here are some things i like:</h2>
    <p class="likes">quiet interfaces, serif type, open source, walking, making hard things simple, notebooks, the command line, well-written blogs, morning light</p>
  </section>

  <section class="section">
    <h2>things i don't like:</h2>
    <ul class="list">
      <li>writing to be seen</li>
    </ul>
  </section>

  <section class="section prose">
    <p>
      i like people and write back. <a href={mail}>send me a message</a> (github probably works for now)
    </p>
  </section>
</Layout>
